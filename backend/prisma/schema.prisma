// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEAM_MEMBER
  MANAGER
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  BLOCKED
  CARRIED_OVER
}

enum TaskType {
  DEVELOPMENT
  TESTING
  MEETINGS
  DOCUMENTATION
  DESIGN
  RESEARCH
  SUPPORT
  OTHER
}

enum ReviewActionType {
  APPROVED
  REQUESTED_CHANGES
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(TEAM_MEMBER)
  jobTitle     String?
  avatarUrl    String?
  isActive     Boolean  @default(true)

  managerId   String?
  manager     User?   @relation("ManagerTeam", fields: [managerId], references: [id], onDelete: SetNull)
  teamMembers User[]  @relation("ManagerTeam")

  projectMemberships ProjectMember[]
  reports            WeeklyReport[]  @relation("ReportAuthor")
  reviewActions      ReviewAction[]  @relation("ReportReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([managerId])
  @@map("users")
}

model Project {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  color       String?
  isActive    Boolean @default(true)

  members ProjectMember[]
  reports WeeklyReport[]
  tasks   ReportTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("projects")
}

model ProjectMember {
  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@id([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

model WeeklyReport {
  id        String       @id @default(uuid())
  authorId  String
  projectId String
  weekStart DateTime     @db.Date
  weekEnd   DateTime     @db.Date
  status    ReportStatus @default(DRAFT)

  notes                 String?
  latestReviewerComment String?
  submittedAt           DateTime?
  approvedAt            DateTime?

  author  User    @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id])

  tasks         ReportTask[]
  nextWeekTasks NextWeekTask[]
  blockers      Blocker[]
  achievements  Achievement[]
  timeEntries   TimeEntry[]
  links         ReportLink[]
  versions      ReportVersion[]
  reviewActions ReviewAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, weekStart])
  @@index([status])
  @@index([projectId])
  @@index([weekStart, weekEnd])
  @@index([authorId, status])
  @@map("weekly_reports")
}

model ReportTask {
  id        String  @id @default(uuid())
  reportId  String
  projectId String?

  name              String
  priority          TaskPriority
  plannedPercentage Int
  actualPercentage  Int
  status            TaskStatus
  plannedMinutes    Int
  actualMinutes     Int
  deliverable       String?

  report  WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  project Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@index([projectId])
  @@index([status])
  @@map("report_tasks")
}

model NextWeekTask {
  id       String @id @default(uuid())
  reportId String

  name        String
  description String?
  priority    TaskPriority @default(MEDIUM)

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@map("next_week_tasks")
}

model Blocker {
  id       String @id @default(uuid())
  reportId String

  title       String
  description String?
  isKeyIssue  Boolean @default(false)
  isResolved  Boolean @default(false)

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@index([isResolved])
  @@map("blockers")
}

model Achievement {
  id       String @id @default(uuid())
  reportId String

  title            String
  description      String?
  isKeyAchievement Boolean @default(false)

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@map("achievements")
}

model TimeEntry {
  id       String @id @default(uuid())
  reportId String

  taskType TaskType
  minutes  Int

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportId, taskType])
  @@index([reportId])
  @@map("time_entries")
}

model ReportLink {
  id       String @id @default(uuid())
  reportId String

  label String
  url   String

  report WeeklyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_links")
}

model ReportVersion {
  id            String   @id @default(uuid())
  reportId      String
  versionNumber Int
  content       Json
  submittedAt   DateTime @default(now())

  report       WeeklyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviewAction ReviewAction?

  @@unique([reportId, versionNumber])
  @@index([reportId, submittedAt])
  @@map("report_versions")
}

model ReviewAction {
  id         String           @id @default(uuid())
  reportId   String
  versionId  String           @unique
  reviewerId String
  action     ReviewActionType
  comment    String?
  createdAt  DateTime         @default(now())

  report   WeeklyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version  ReportVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewer User          @relation("ReportReviewer", fields: [reviewerId], references: [id])

  @@index([reportId])
  @@index([reviewerId])
  @@index([action])
  @@index([createdAt])
  @@map("review_actions")
}
